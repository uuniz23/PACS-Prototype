# .streamlit/secrets.toml 예시 (키 이름만 있는 파일입니다)
#
# 사용 방법
# 1) 실제 값은 팀장에게 1:1 메시지로 직접 받습니다.
# 2) 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채웁니다.
# 3) secrets.toml 은 .gitignore 에 들어 있어 커밋되지 않습니다.
#    GitHub, Issue, PR, 단체방에는 절대 올리지 않습니다.
#
# 아래 키 이름은 예시입니다. 팀이 Firebase 연동 방식을 확정하면 그에 맞게 수정합니다.

[firebase]
api_key = ""

[firebase_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
